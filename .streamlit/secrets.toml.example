# ====================================================
# Streamlit Secrets — copy to secrets.toml and fill in
# (Do NOT commit secrets.toml — it is in .gitignore)
# ====================================================

# URL of the FastAPI backend.
# When running locally both Streamlit and FastAPI on the same machine,
# leave this as the default (no need to set it at all).
# When deploying Streamlit to Streamlit Cloud or Render separately
# from FastAPI, set this to the public URL of your FastAPI backend.

API_BASE_URL = "https://your-fastapi-backend.onrender.com"

